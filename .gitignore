# Node
node_modules/
dist/
.pnpm-debug.log*

# Generated — committed on purpose so CI/dev can build without a live API running first.
# apps/web/src/client/schema.d.ts is intentionally tracked, not ignored.
apps/web/openapi.json

# apps/web/src/routeTree.gen.ts is generated by the TanStack Router vite plugin, and is
# tracked for the same reason as schema.d.ts above: only the *bundler* regenerates it, but
# `tsc -b` and eslint both need it to exist, and `pnpm run build` type-checks BEFORE it ever
# runs vite. Ignoring it made a fresh checkout unable to lint or build until someone ran vite
# once by hand — which CI and the Docker `final` stage never do.

# Env / secrets
.env
.env.*
!.env.example

