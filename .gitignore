# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node
node_modules/
dist/
.pnpm-debug.log*

# Generated — committed on purpose so CI/dev can build without a live API running first.
# apps/web/src/client/schema.d.ts is intentionally tracked, not ignored.
apps/web/openapi.json

# Generated by the TanStack Router vite plugin on every dev/build — no external dependency
# (unlike schema.d.ts above), so nothing to gain from committing it.
apps/web/src/routeTree.gen.ts

# Env / secrets
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.vscode/
.idea/

# Generated by apps/web/scripts/fetch-pyodide.mjs (a prebuild step): the self-hosted Python
# runtime and sympy wheel the translator sandbox loads. ~20MB of build output, not source.
apps/web/public/pyodide/

# `just wt-add` puts each worktree here. Narrower than ignoring .claude/, which carries the
# tracked merge-gate hooks and settings.json. Worth being explicit about: a linked worktree holds
# a .git FILE rather than a directory, so git raises no embedded-repository warning for it — an
# `git add -A` in the main checkout would quietly add every worktree's source as duplicate files.
.claude/worktrees/

