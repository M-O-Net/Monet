# Generated — committed on purpose so CI/dev can build without a live API running first.
# apps/web/src/client/schema.d.ts is intentionally tracked, not ignored.
# apps/web/src/routeTree.gen.ts likewise: eslint and `tsc6 -b` both read it before any build has
# run, so a fresh checkout cannot lint or build without it. ci.yml proves the copy stays current.
apps/web/openapi.json

