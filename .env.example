# Copy to .env and set a real POSTGRES_PASSWORD. docker-compose reads this automatically
# (see Justfile's `set dotenv-load` / _env_flags, and docker-compose.yml's required var).
#
# DATABASE_URL and VITE_API_URL are NOT set here — docker-compose.yml/docker-compose.dev.yml
# construct them from POSTGRES_PASSWORD/API_PORT directly, so both always match whatever this
# worktree's own .env.local (see `just wt-add`) actually is. The same goes for the test service's
# own DATABASE_URL (the monet_test database) — there is deliberately nothing to configure here
# for it, and nothing to hand-write in apps/api/.env either.
#
# There is no PG_PORT: Postgres publishes no host port at all (see docker-compose.yml).

POSTGRES_PASSWORD=changeme
